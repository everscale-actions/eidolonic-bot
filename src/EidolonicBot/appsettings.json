{
  "Bot": {
    "Token": "BOT_API_TOKEN_HERE"
  },
  "Wallet": {
    "SeedPhrase": "YOUR_SEED_PHRASE_HERE"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information"
    },
    "Enrich": [
      "FromLogContext",
      "WithEnvironmentName"
    ],
    "WriteTo:Console": {
      "Name": "Console",
      "Args": {
        "theme": "Serilog.Sinks.SystemConsole.Themes.AnsiConsoleTheme::Code, Serilog.Sinks.Console",
        "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} <s:{SourceContext}>{NewLine}{Exception}",
      }
    },
    "WriteTo:File": {
      "Name": "File",
      "Args": {
        "path": "./logs/log.json",
        "rollingInterval": "Day",
        "formatter": "Serilog.Formatting.Json.JsonFormatter"
      }
    }
  },
  "Sentry": {
    "MinimumBreadcrumbLevel": "Debug",
    "MinimumEventLevel": "Warning"
  },
  "MemoryCache": {
    "SizeLimit": 10000
  },
  "Blockchain": {
    "DefaultExplorer": "everscale.autos",
    "Explorers:Evertrace": {
      "Name": "everscale.autos",
      "TransactionLinkTemplate": "https://everscale.autos/transactions/{0}",
      "AccountLinkTemplate": "https://everscale.autos/accounts/{0}"
    },
    "Explorers:Everlive": {
      "Name": "ever.live",
      "TransactionLinkTemplate": "https://ever.live/transactions/transactionDetails?id={0}",
      "AccountLinkTemplate": "https://ever.live/accounts/accountDetails?id={0}"
    }
  }
}
